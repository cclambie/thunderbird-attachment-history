{
  "manifest_version": 3,
  "name": "Attachment History",
  "version": "0.1.0",
  "description": "Save attachments and get a downloads-style history with one-click open of the file or folder.",
  "browser_specific_settings": {
    "gecko": {
      "id": "attachment-downloads@craiglambie.com",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "menus",
    "downloads",
    "downloads.open",
    "storage",
    "messagesRead",
    "notifications",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Attachment History",
    "default_label": "Attachments",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "author": "Craig Lambie",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
